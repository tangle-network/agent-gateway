{
  "name": "@tangle-network/agent-gateway",
  "version": "0.11.4",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/agent-gateway.git"
  },
  "type": "module",
  "description": "x402 + API key payment gateway for Tangle agent products. Mount on any Hono app to expose agents as paid OpenAI-compatible endpoints.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./observer": {
      "types": "./dist/observer.d.ts",
      "import": "./dist/observer.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@tangle-network/agent-app": "0.47.6",
    "@tangle-network/agent-interface": "2.3.0",
    "@tangle-network/agent-runtime": "0.192.2",
    "@tangle-network/sandbox": "0.37.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "viem": "^2.56.2",
    "vite": "8.0.16",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.13.5",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "vite": "8.0.16",
      "esbuild": "0.28.1"
    }
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
